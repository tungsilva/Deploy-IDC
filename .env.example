# Bizfly Server Monitor — cấu hình. Chép thành .env, điền các dòng bắt buộc, rồi:
#   docker compose up -d
#
# Sinh nhanh mọi bí mật còn trống (chạy một lần, ngay sau khi chép):
#   for k in POSTGRES_PASSWORD REDIS_PASSWORD JWT_SECRET BMC_CREDENTIALS_ENCRYPTION_KEY ADMIN_PASSWORD; do
#     sed -i "s|^$k=$|$k=$(openssl rand -hex 32)|" .env; done

# ── Bắt buộc ────────────────────────────────────────────────────────────
# Nơi lấy image (có dấu / ở cuối) và phiên bản. Nên GHIM số phiên bản
# thay vì latest, để biết chắc máy đang chạy bản nào. Các bản đã phát hành:
# https://hub.docker.com/r/tungsilva10/monitor-hardware-api/tags
MH_REGISTRY=docker.io/tungsilva10/
MH_VERSION=2026.11.05.1

# IP hoặc tên mà agent và worker node dùng để gọi máy này. Chứng chỉ TLS tự
# sinh sẽ mang địa chỉ này.
CORE_EXTERNAL_HOST=
# Tên/IP khác cũng phải nằm trong chứng chỉ, cách nhau dấu phẩy. BẮT BUỘC
# thêm địa chỉ ingest (VIP) của MỌI Worker Group: worker node dùng chung
# chứng chỉ của Core, và agent kiểm tên khi gọi vào VIP.
# Thêm VIP mới về sau: sửa dòng này rồi `docker compose up -d` — chứng chỉ tự
# sinh lại (giữ CA cũ), worker node tự tải bản mới trong ~2 phút.
CERT_EXTRA_SANS=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# Mã hoá mật khẩu BMC/ESXi đã lưu. ĐỔI SAU KHI CÓ DỮ LIỆU = MẤT HẾT chúng.
# Sao lưu .env ra nơi an toàn.
BMC_CREDENTIALS_ENCRYPTION_KEY=

# Tài khoản quản trị tạo ở lần chạy đầu (về sau không bị đặt lại).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Tuỳ chọn (bỏ trống = mặc định) ─────────────────────────────────────
# Cổng: web 8443, API 3000 (agent/worker node gọi vào).
# WEB_PORT=8443
# API_PUBLISHED_PORT=3000

# Có worker node ở máy khác: đặt hai dòng này = IP mạng riêng của máy này
# (mặc định chỉ loopback). Không bao giờ dùng 0.0.0.0 trên máy có IP công cộng.
# POSTGRES_BIND_ADDRESS=127.0.0.1
# REDIS_BIND_ADDRESS=127.0.0.1

# Cỡ máy (xem README): số worker và tham số Postgres.
# WORKER_REPLICAS=7
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=4GB

# Lưu trữ: log 1 năm, số liệu thô 30 ngày (biểu đồ dài hạn dùng bảng gộp).
# DATA_RETENTION_DAYS=365
# METRIC_RAW_RETENTION_DAYS=30
